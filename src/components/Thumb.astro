---
const { url, slug, summary, title, src, alt, category, company, date } = Astro.props;
const formattedDate = date ? new Date(date + 'T00:00:00').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : null;
---
<div class="card">
	<a href={url} class="thumb">
		<span class="hoverbutton"><span>Read on</span></span>
		<img src={src} alt={alt} />
	</a>
	<div class="text">
		<span class="category">{category}</span>
		{formattedDate && <span class="date">{formattedDate}</span>}
		<h3 class="title">{title}</h3>
		<span class="company">{company}</span>
		<p class="summary">{summary}</p>
		<a href={url} class="readon">Read on</a>
	</div>
</div>